{
  "name": "saa-study-studio",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bank:validate": "node scripts/validate-bank.mjs",
    "desktop:dev": "node scripts/prepare-electron.mjs && npm run build && electron .",
    "desktop:package": "node scripts/prepare-electron.mjs && npm run build && electron-builder --win --publish never",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/wasi-threads": "^1.2.3",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.4"
  },
  "main": "desktop/main.cjs",
  "description": "Offline AWS SAA exam simulator and structured study course with local email profiles",
  "author": "tanishqsgit",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanishqsgit/AWS-SAA-EXAM-PREP.git"
  }
}
